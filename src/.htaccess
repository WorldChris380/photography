# Security hardening for server-side files in this folder
# Deny direct web access to secrets, logs, and debug utilities
<FilesMatch "^(paypal-secret\.php|view-logs\.php|oauth-test\.php|.*\.log)$">
  Require all denied
</FilesMatch>

# If your Apache uses 2.2 syntax, uncomment the following
# <FilesMatch "^(paypal-secret\.php|view-logs\.php|oauth-test\.php|.*\.log)$">
#   Deny from all
# </FilesMatch>

# Prevent directory listing just in case
Options -Indexes
