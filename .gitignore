testem.log
/typings

# System files
.DS_Store
Thumbs.db

# My individual excluded files
public/img/photography/
scripts/Anleitung für automatische Website Konvertierung und Optimierung.txt

# Environment files (keep examples, ignore real secrets)
.env
.env.*
**/.env
**/.env.*
**/.env.example

# PayPal secret definition files (do not track anywhere in the tree)
paypal-secret.php
**/paypal-secret.php

# README files (keep internal documentation private)
README.md
**/README.md